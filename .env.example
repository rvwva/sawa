# ─── Database ───────────────────────────────────────────────────────────────
DATABASE_URL="postgresql://sawa:changeme@localhost:5432/sawa_db"

# ─── API Server ─────────────────────────────────────────────────────────────
API_PORT=4000
API_HOST=0.0.0.0
NODE_ENV=development

# ─── JWT Auth ────────────────────────────────────────────────────────────────
JWT_SECRET=replace-with-64-char-random-secret
JWT_EXPIRES_IN=8h
REFRESH_TOKEN_SECRET=replace-with-another-64-char-random-secret
REFRESH_TOKEN_EXPIRES_IN=30d

# ─── Next.js Web ─────────────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:4000/api
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ─── Scoring Service (Python/FastAPI) ────────────────────────────────────────
SCORING_SERVICE_URL=http://localhost:8000
SCORING_SERVICE_API_KEY=replace-with-scoring-service-key

# ─── SendGrid Email ──────────────────────────────────────────────────────────
SENDGRID_API_KEY=SG.replace-with-sendgrid-key
EMAIL_FROM=noreply@sawa.app
EMAIL_FROM_NAME=Sawa Platform

# ─── Google Cloud Storage (PDF reports) ──────────────────────────────────────
GCS_BUCKET=sawa-reports
GCS_PROJECT_ID=sawa-prod
GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json

# ─── PDF Generation ──────────────────────────────────────────────────────────
PUPPETEER_EXECUTABLE_PATH=/usr/bin/chromium

# ─── Rate Limiting ───────────────────────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# ─── Data Retention ──────────────────────────────────────────────────────────
# Auto-delete responses older than this many years (compliance: 5 years)
DATA_RETENTION_YEARS=5
